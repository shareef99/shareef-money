# EAS uses this file INSTEAD of .gitignore when present, so it must list
# everything that should NOT be uploaded to the build servers.

# Dependencies — EAS installs these fresh on the build server
node_modules/
**/node_modules/

# Local native projects — EAS runs `expo prebuild` itself. Our local android/
# is Windows-specific (local.properties points at a Windows SDK path) and would
# break the Linux build, plus it carries huge gradle/.cxx caches.
apps/mobile/android/
apps/mobile/ios/

# Build outputs / caches (not needed to build the mobile app)
**/.cxx/
**/.gradle/
**/dist/
**/build/
**/.expo/
.expo/
apps/backend/data/

# VCS / editor / logs / OS junk
.git/
.vscode/
*.log
.DS_Store
Thumbs.db
