{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env src/migrate.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-openapi": "^1.4.0",
    "@scalar/hono-api-reference": "^0.10.19",
    "zod": "^4.0.0",
    "jose": "^6.0.0",
    "argon2": "^0.41.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.44.0",
    "@shareef-money/db": "workspace:*",
    "@shareef-money/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@10.29.3"
}
