# Server
PORT=3001
NODE_ENV=development

# Database (libSQL). Local dev uses a plain SQLite file; production points at
# Turso. Local files MUST use the file: scheme.
DATABASE_URL=file:./data/server.db
# DATABASE_URL=libsql://<db-name>-<org>.turso.io
# Only needed for a hosted Turso database (leave empty for a local file).
DATABASE_AUTH_TOKEN=

# Auth — generate a long random string (>= 32 chars), e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Optional Google sign-in
GOOGLE_CLIENT_ID=

# CORS: the origin of the deployed web app
WEB_URL=http://localhost:3100
